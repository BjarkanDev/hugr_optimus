{
  "name": "ROS 2 Jazzy Development",
  "build": {
    "dockerfile": "../Dockerfile"
  },
  "runArgs": [
    "--net=host",
    "--ipc=host"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-iot.vscode-ros",
        "ms-vscode.cpptools",
        "ms-python.python",
        "twxs.cmake"
      ]
    }
  },
  "workspaceFolder": "/home/ros/ros2_ws/src/project_repo",
  "mounts": [
    "source=${localWorkspaceFolder},target=/home/ros/ros2_ws/src/project_repo,type=bind"
  ],
  "remoteUser": "ros"
}
